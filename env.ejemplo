# Jarvis Voz: configuración. El instalador crea el archivo .env por ti a partir de este ejemplo.
# El .env real tiene tu clave: no lo compartas ni lo subas a ningún lado.

# Clave de la API de Gemini (voz en tiempo real). Gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Llave local de la página (el instalador la crea; el acceso directo la usa).
LLAVE_LOCAL=

# Puerto local (la página abre en http://localhost:PUERTO). Solo esta computadora lo ve.
PUERTO=8787

# Nombre de tu asistente, tu nombre (opcional) y tu zona horaria.
ASISTENTE_NOMBRE=Jarvis
USUARIO_NOMBRE=
ZONA_HORARIA=

# Voz: modelo de Gemini Live, modelo de reserva (si se acaba la cuota del principal), voz e idioma.
# Voces probadas: Charon, Kore, Aoede, Orus, Fenrir.
VOZ_MODELO=gemini-3.8-live
VOZ_MODELO_RESERVA=gemini-3.1-flash-live-preview
VOZ_NOMBRE=Charon
VOZ_IDIOMA=es-US

# Control de gasto de la voz: minutos por día (al llegar, la voz se pausa hasta mañana)
# y pausa automática si nadie habla durante estos segundos (0 = nunca).
MINUTOS_POR_DIA=30
PAUSA_SIN_ACTIVIDAD_SEG=120

# Cuando una tarea termina, Jarvis te avisa hablando (si=sí, no=solo en la pantalla).
AVISAR_POR_VOZ=si

# Motores de tareas, en orden de preferencia. Si uno llega al límite de su plan, sigue el próximo.
#   claude = Claude Code (recomendado) · codex = Codex CLI (ChatGPT) · gemini = Gemini CLI (Google)
MOTORES=claude,codex,gemini
# Modelos de cada motor (vacío = el que el motor usa por defecto).
MODELO_CLAUDE=
MODELO_CODEX=
MODELO_GEMINI=
# Tareas al mismo tiempo y tiempo máximo de cada una.
TAREAS_SIMULTANEAS=3
TAREA_MAX_MIN=30
# Permitir que las tareas usen la terminal (necesario para Leo, el programador). si / no
PERMITIR_COMANDOS=si

# Carpeta de trabajo de las tareas (reglas, memoria, especialistas y entregas).
ESPACIO=espacio

# Guarda el texto de las conversaciones en datos/conversaciones (solo en tu computadora).
GUARDAR_CONVERSACION=si
# Diagnóstico: guarda el audio de cada conversación en datos/grabaciones. Déjalo en "no".
GRABAR_AUDIO=no
